@model ECommerce.Web.Controllers.HomeViewModel

@{
    ViewData["Title"] = ViewData["Title"] ?? "E-Commerce Store";
}

<div class="container my-5">
    <h1 class="text-center mb-5">Welcome to Our E-Commerce Store</h1>

    <!-- Featured Categories -->
    <section class="mb-5">
        <h2 class="mb-4">Browse Categories</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var category in Model.Categories)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body text-center">
                            <h5 class="card-title">@category.Name</h5>
                            @if (!string.IsNullOrEmpty(category.Description))
                            {
                                <p class="card-text text-muted">@category.Description</p>
                            }
                            <a asp-area="Admin" asp-controller="Category" asp-action="Index"
                               class="btn btn-outline-primary btn-sm mt-3">
                                View in Admin
                            </a>
                        </div>
                    </div>
                </div>
            }
            @if (!Model.Categories.Any())
            {
                <p class="text-center text-muted">No categories available yet.</p>
            }
        </div>
    </section>

    <!-- Our Products -->
    <section>
        <h2 class="mb-4">Our Products</h2>
        <div class="row row-cols-1 row-cols-md-4 g-4">
            @foreach (var product in Model.Products)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text text-success fw-bold">@product.Price.ToString("C")</p>
                            <p class="card-text text-info">Stock: @product.StockQuantity</p> <!-- Added stock display -->
                            @if (!string.IsNullOrEmpty(product.Description))
                            {
                                <p class="card-text text-muted flex-grow-1">
                                    @product.Description.Substring(0, Math.Min(80, product.Description.Length))...
                                </p>
                            }
                            <p class="text-muted small">Category: @(product.Category?.Name ?? "Uncategorized")</p>
                        </div>
                        <div class="card-footer bg-transparent border-0">
                            <a asp-area="Admin" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id"
                               class="btn btn-primary btn-sm w-100">
                                View Product
                            </a>
                        </div>
                    </div>
                </div>
            }
            @if (!Model.Products.Any())
            {
                <p class="text-center text-muted mt-4">No products available yet.</p>
            }
        </div>
    </section>
</div>