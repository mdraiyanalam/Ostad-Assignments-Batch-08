@model Product

<div class="card">
    <div class="card-header">
        <h3 class="mb-0">Product Details</h3>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3 fw-bold">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3 fw-bold">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3 fw-bold">Price</dt>
            <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

            <dt class="col-sm-3 fw-bold">Stock Quantity</dt>
            <dd class="col-sm-9">@Model.StockQuantity</dd>

            <dt class="col-sm-3 fw-bold">Description</dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <em class="text-muted">No description provided</em>
                }
                else
                {
                    @Model.Description
                }
            </dd>

            <dt class="col-sm-3 fw-bold">Category ID</dt>
            <dd class="col-sm-9">@Model.CategoryId</dd>

            @if (Model.Category != null)
            {
                <dt class="col-sm-3 fw-bold">Category Name</dt>
                <dd class="col-sm-9">@Model.Category.Name</dd>
            }
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}