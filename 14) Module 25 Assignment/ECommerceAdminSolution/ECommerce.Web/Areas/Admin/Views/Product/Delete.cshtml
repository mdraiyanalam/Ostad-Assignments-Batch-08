@model Product

<div class="card border-danger">
    <div class="card-header bg-danger text-white">
        <h3 class="mb-0">Delete Product - Confirmation</h3>
    </div>
    <div class="card-body">
        <h4 class="text-danger">Are you sure you want to delete this product?</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3 fw-bold">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3 fw-bold">Price</dt>
            <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

            <dt class="col-sm-3 fw-bold">Category ID</dt>
            <dd class="col-sm-9">@Model.CategoryId</dd>

            @if (Model.Category != null)
            {
                <dt class="col-sm-3 fw-bold">Category</dt>
                <dd class="col-sm-9">@Model.Category.Name</dd>
            }

            <dt class="col-sm-3 fw-bold">Description</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "(none)" : Model.Description)
            </dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger me-2">
                <i class="fas fa-trash-alt"></i> Yes, Delete Permanently
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>