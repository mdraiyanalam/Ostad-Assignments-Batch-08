@model IEnumerable<EventManagementSystem.Models.User>

<h2>Users</h2>
<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Contact Number</th>
            <th>Email</th>
            <th>User Type</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.ContactNumber</td>
                <td>@item.Email</td>
                <td>
                    @{
                        string typeText = item.UserType switch
                        {
                            1 => "Admin User",
                            2 => "Standard User",
                            3 => "External User",
                            4 => "Guest User",
                            _ => "Unknown"
                        };
                    }
                    @typeText
                </td>
            </tr>
        }
    </tbody>
</table>