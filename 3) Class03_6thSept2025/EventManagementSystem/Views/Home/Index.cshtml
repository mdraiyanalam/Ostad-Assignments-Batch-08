@{
    ViewData["Title"] = "Home - Quick-Event Solution Ltd.";
}

<div class="text-center mt-5">
    <h1 class="display-4 text-success fw-bold">Welcome to Quick-Event Solution Ltd.</h1>
    <p class="lead mt-4">Your trusted platform for managing events efficiently</p>

    <hr class="my-5" />

    <div class="row mt-5">
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="bi bi-calendar-event display-1 text-primary"></i>
                    <h4 class="mt-3">All Events</h4>
                    <p>View past and future events</p>
                    <a asp-controller="Events" asp-action="AllEvents" class="btn btn-outline-primary">Browse All Events</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="bi bi-clock-history display-1 text-success"></i>
                    <h4 class="mt-3">Upcoming Events</h4>
                    <p>See what's coming next</p>
                    <a asp-controller="Events" asp-action="UpcomingEvents" class="btn btn-success">View Upcoming</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="bi bi-people display-1 text-info"></i>
                    <h4 class="mt-3">Team Members</h4>
                    <p>Meet our users and organizers</p>
                    <a asp-controller="Users" asp-action="Index" class="btn btn-outline-info">View Users</a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5 p-4 bg-light rounded">
        <h4>Quick Tip:</h4>
        <p class="mb-0">Use the navigation bar above or click any card to explore the system!</p>
    </div>
</div>