@model IEnumerable<EventManagementSystem.Models.Event>

@{
    ViewData["Title"] = "All Events";
}

<h2 class="mt-4 mb-3">All Events</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No events found.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Date</th>
                <th>Address</th>
                <th>Assigned User</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.Date.ToString("dd-MMM-yyyy")</td>
                    <td>@item.Address</td>
                    <td>
                        @if (item.AssignedUser != null)
                        {
                            <span>@item.AssignedUser.FirstName @item.AssignedUser.LastName</span>
                        }
                        else
                        {
                            <em>None</em>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}