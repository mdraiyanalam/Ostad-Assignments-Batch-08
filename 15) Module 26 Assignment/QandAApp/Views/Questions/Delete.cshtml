@model QandAApp.Entities.Question

@{
    ViewData["Title"] = "Delete Question";
}

<h1>Delete Question</h1>

<h3>Are you sure you want to delete this?</h3>

<div class="border p-3 mb-3">
    <h4>@Model.Title</h4>
    <p>@Model.Body</p>
    <p class="text-muted">Asked by @Model.User?.UserName on @Model.CreatedAt.ToString("MMM dd, yyyy")</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Yes, delete this question</button>
    <a asp-action="Index" class="btn btn-outline-secondary">No, go back</a>
</form>