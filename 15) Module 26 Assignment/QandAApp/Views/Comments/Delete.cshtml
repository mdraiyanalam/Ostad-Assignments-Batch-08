@model QandAApp.Entities.Comment

@{
    ViewData["Title"] = "Delete Comment";
}

<h1>Delete Comment</h1>

<h3>Are you sure you want to delete this?</h3>

<div class="border p-3 mb-3">
    <p>@Model.Body</p>
    <p class="text-muted">Commented by @Model.User?.UserName on @Model.CreatedAt.ToString("MMM dd, yyyy")</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Yes, delete this comment</button>
    <a asp-controller="Questions" asp-action="Details" asp-route-id="@(Model.QuestionId ?? Model.Answer?.QuestionId)" class="btn btn-outline-secondary">No, go back</a>
</form>