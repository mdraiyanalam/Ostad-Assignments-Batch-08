@model Category
<form asp-action="@(ViewContext.RouteData.Values["Action"])" method="post" class="row g-3">
    @if (ViewContext.RouteData.Values["Action"]?.ToString() == "Edit")
    {
        <input type="hidden" asp-for="Id" />
    }
    <div class="col-md-8">
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div>
        <button type="submit" class="btn btn-success me-2">@(ViewContext.RouteData.Values["Action"]?.ToString() == "Edit" ? "Save" : "Create")</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}